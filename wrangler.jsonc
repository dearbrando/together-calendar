{
  // Together — family calendar. Deploy with: npx wrangler deploy
  "name": "together-calendar",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "FAMILY", "class_name": "Family" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Family"] }]
}
